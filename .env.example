# Server Configuration
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"

# Database Configuration
# Supported values: sqlite (default zero-config relational DB) or mysql (production MySQL 8+)
DB_CLIENT=sqlite
SQLITE_PATH=./database/bgs_academic.db

# Production MySQL Connection (used when DB_CLIENT=mysql)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=bgs_app
MYSQL_PASSWORD=
MYSQL_DATABASE=buyanja_grammar_db

# JWT Security Secrets (keep empty in .env.example; set strong random values in production)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Optional SMTP Email Notifications (Nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Buyanja Grammar School <academics@buyanjagrammar.ac.ug>"
